# 网关地址（不带结尾斜杠）
FILSE_BASE_URL=https://api.example.com
# 应用凭据（服务端保存，切勿下发给前端）
FILSE_APP_ID=demo_public
FILSE_APP_KEY=demo_key_123456
# 应用开启了域名白名单时，必须提供一个白名单内的 Origin
FILSE_ORIGIN=https://example.com
# 可选：运维工具接口使用（服务端配置了 ADMIN_TOKEN 时）
FILSE_ADMIN_TOKEN=
# 上传超时（秒），大文件建议 300 以上
FILSE_TIMEOUT=300
FILSE_CONNECT_TIMEOUT=10
FILSE_VERIFY_SSL=true
FILSE_USER_AGENT=zeyen-filse/1.0
